# Copy to .env for local use; Node only reads it with --env-file=.env.
PORT=3000
PUBLIC_BASE_URL=https://gold-pulse-ai.onrender.com
DATA_DIR=.data
# Set two DIFFERENT randomly generated secrets, each at least 32 characters.
MT5_INGEST_TOKEN=
DASHBOARD_TOKEN=

# EA uses the actual MT5 bot plan. DASHBOARD selects the separate website strategy.
SIGNAL_SOURCE=EA

# Leave false on Render Free. Enable only after DATA_DIR is on verified durable storage.
# Monitoring, charting, and the calculator work without remote trade controls.
PERSISTENT_STORAGE_CONFIRMED=false
# حسابات نبض: قاعدة PostgreSQL مستقلة، بلا رجوع إلى قرص الاستضافة المؤقت.
AUTH_DATABASE_URL=
# مفتاح عشوائي 32 بايت بترميز base64؛ احتفظ به خارج المستودع ولا تغيّره بعد تفعيل MFA.
AUTH_ENCRYPTION_KEY=
# البريد الوحيد المؤهل لإنشاء الأدمن الأول، بعد تحقق ملكية البريد وتفعيل TOTP.
AUTH_ADMIN_EMAIL=
AUTH_MAIL_FROM=
# اختر Resend بمُرسل موثّق أو SMTP عبر TLS (لا يلزم ضبط الخيارين).
AUTH_MAIL_API_KEY=
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=465
AUTH_SMTP_SECURE=true
AUTH_SMTP_USER=
AUTH_SMTP_PASSWORD=
# نسخ حسابات مشفر إلى S3-compatible مستقل، مرة يوميًا عند تشغيل الخدمة.
AUTH_BACKUP_KEY=
AUTH_BACKUP_ENDPOINT=
AUTH_BACKUP_BUCKET=
AUTH_BACKUP_REGION=auto
AUTH_BACKUP_ACCESS_KEY=
AUTH_BACKUP_SECRET_KEY=
