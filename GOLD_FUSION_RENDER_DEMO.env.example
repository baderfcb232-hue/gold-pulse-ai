# Add the following to the confirmed Render WEB SERVICE environment.
# DO NOT upload this example as .env with secrets or assume Render reads it automatically.
# Use an ISOLATED JustMarkets Demo account to validate execution.
NABD_GOLD_SIGNAL_STRATEGY=FUSION
NABD_GOLD_FUSION_DEMO_AUTOTRADE=true
DEMO_RECOMMENDATION_EXECUTION=true
SIGNAL_PUBLICATION_ENABLED=true
SIGNAL_SOURCE=EA
# Never set NABD_GOLD_ONLY=true unless deliberately disabling BTC.
# Keep the existing NABD_BTC_* settings unchanged.
# Prerequisites: verified PostgreSQL AUTH_DATABASE_URL command journal,
# broker costs, fresh MT5 heartbeat/ticks, calendar and 0.5%/2% EA risk caps.
